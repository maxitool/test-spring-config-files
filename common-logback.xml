<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <property name="LOG_FILE" value="${LOGGING_FILE_NAME}"/>

    <appender name="jsonFile" class="ch.qos.logback.core.FileAppender">
        <file>${LOG_FILE}</file>
        <!-- prudent=true гарантирует безопасную параллельную запись нескольких JVM в один файл -->
        <prudent>true</prudent> 
        <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
            <providers>
                <timestamp><timeZone>UTC</timeZone></timestamp>
                <logLevel/>
                <!-- Автоматически подставляет spring.application.name каждого сервиса -->
                <contextName><fieldName>service</fieldName></contextName>
                <threadName/>
                <loggerName/>
                <message/>
                <stackTrace/>
            </providers>
        </encoder>
    </appender>

    <root level="DEBUG">
        <appender-ref ref="jsonFile" />
    </root>
</configuration>