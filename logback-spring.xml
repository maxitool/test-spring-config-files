<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <property name="LOG_FILE" value="${LOGGING_FILE_NAME}"/>
	<springProperty scope="context" name="APP_NAME" source="spring.application.name" defaultValue="unknown-service"/>

    <appender name="jsonFile" class="ch.qos.logback.core.FileAppender">
        <file>${LOG_FILE}</file> 
        <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
            <providers>
                <timestamp><timeZone>UTC</timeZone></timestamp>
                <logLevel/>
                <pattern>
                    <pattern>
                        {
                          "service": "${APP_NAME}"
                        }
                    </pattern>
                </pattern>
                <threadName/>
                <loggerName/>
                <message/>
                <stackTrace/>
            </providers>
        </encoder>
    </appender>

    <root level="DEBUG">
        <appender-ref ref="jsonFile" />
    </root>
</configuration>