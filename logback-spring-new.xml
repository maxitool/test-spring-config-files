<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Получаем имя приложения из Spring контекста -->
    <springProperty scope="context" name="APP_NAME" source="spring.application.name" defaultValue="unknown-service"/>

    <!-- Сетевой аппендер для отправки логов в Loki -->
    <appender name="LOKI" class="com.github.loki4j.logback.Loki4jAppender">
        <http>
            <url>http://railway.internal</url>
        </http>
        <format>
            <label>
                <pattern>app=${APP_NAME},host=${HOSTNAME},level=%level</pattern>
            </label>
            <message class="com.github.loki4j.logback.JsonLayout">
                <customObjectFields>
                    {
                      "service": "${APP_NAME}",
                      "thread": "%thread",
                      "logger": "%logger",
                      "exception": "%ex"
                    }
                </customObjectFields>
            </message>
        </format>
    </appender>

    <!-- Также выводим логи в консоль контейнера, чтобы их было видно в панели Railway -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="DEBUG">
        <appender-ref ref="LOKI" />
        <appender-ref ref="CONSOLE" />
    </root>
</configuration>